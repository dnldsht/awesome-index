{
  "name": "awesome-index",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit && nuxt prepare && vue-tsc --noEmit -p .nuxt/tsconfig.json",
    "format": "prettier --write .",
    "crawl": "node --env-file-if-exists=.env bin/crawl.ts",
    "popularity": "node --env-file-if-exists=.env bin/popularity.ts",
    "fixtures": "node bin/fixtures.ts",
    "shards": "node bin/shards.ts",
    "history": "node --env-file-if-exists=.env bin/history.ts",
    "test": "node --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "nuxt": "^4.5.2",
    "octokit": "^5.0.5",
    "p-queue": "^9.3.3",
    "prettier": "^3.9.6",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.0"
  }
}
