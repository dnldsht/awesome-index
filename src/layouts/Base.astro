---
import "../styles/global.css";
import { OG_DEFAULT_PATH } from "../lib/og.ts";
import { absolute } from "../lib/urls.ts";

export type Props = {
  title: string;
  description: string;
  /** defaults to the current route; pass one only to override a canonical */
  canonicalPath?: string;
  noindex?: boolean;
  /** JSON-LD objects, serialised into ld+json script tags */
  jsonLd?: unknown[];
  /** site-root path of a build-time card, e.g. ogListPath(slug); see src/lib/og.ts */
  ogImage?: string;
};

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  jsonLd = [],
} = Astro.props;

// both go through absolute() so the canonical and the sitemap can only ever
// derive from one place; Astro.site is additionally illegal inside
// getStaticPaths, so the helper is the form that works everywhere
const canonical = absolute(canonicalPath);
const ogImage = absolute(Astro.props.ogImage ?? OG_DEFAULT_PATH);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Awesome Index" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#12151c"
      media="(prefers-color-scheme: dark)"
    />

    {/*
      Runs before the first paint so an explicit choice never flashes the other
      theme. It is deliberately tiny and inline: pulling it into a module would
      cost a round trip, and the round trip is the flash. Absence of the key
      means "follow the system", which the stylesheet already handles.
    */}
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark")
          document.documentElement.dataset.theme = t;
      } catch {}
    </script>

    {
      jsonLd.map((item) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(item)}
          is:inline
        />
      ))
    }
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-paper focus:px-3 focus:py-2"
    >
      Skip to content
    </a>

    <header class="border-b border-rule">
      <div
        class="mx-auto flex max-w-6xl items-baseline gap-4 px-5 py-4 sm:px-8"
      >
        <a
          href="/"
          class="font-display text-lg font-semibold tracking-tight text-ink"
        >
          Awesome Index
        </a>
        <span class="hidden text-sm text-mute sm:inline">
          curated lists, with the parts that went quiet marked
        </span>

        <button
          id="theme-toggle"
          type="button"
          class="ml-auto shrink-0 cursor-pointer border border-rule px-2.5 py-1 font-mono text-xs text-ink-soft hover:bg-sunk"
          aria-pressed="false"
        >
          <span aria-hidden="true">◑</span>
          <span class="sr-only">Switch to dark theme</span>
        </button>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-6xl px-5 py-8 sm:px-8">
      <slot />
    </main>

    <footer class="mt-16 border-t border-rule">
      <div
        class="mx-auto flex max-w-6xl flex-wrap gap-x-6 gap-y-2 px-5 py-8 text-sm text-mute sm:px-8"
      >
        <span>
          Figures are a snapshot from the last crawl, not live from GitHub.
        </span>
        <a class="text-accent hover:underline" href="/">All lists</a>
      </div>
    </footer>

    {/*
      The button is the only stateful control on a content page, so it gets a
      dozen lines of inline script rather than an island: hydrating a component
      to toggle one attribute would ship a framework to every page on the site.
      The label always names the theme the click will switch *to*.
    */}
    <script is:inline>
      (() => {
        const button = document.getElementById("theme-toggle");
        if (!button) return;
        const root = document.documentElement;
        const media = matchMedia("(prefers-color-scheme: dark)");
        const label = button.querySelector(".sr-only");

        const isDark = () =>
          root.dataset.theme ? root.dataset.theme === "dark" : media.matches;

        const sync = () => {
          const dark = isDark();
          button.setAttribute("aria-pressed", String(dark));
          if (label)
            label.textContent = `Switch to ${dark ? "light" : "dark"} theme`;
        };

        button.addEventListener("click", () => {
          const next = isDark() ? "light" : "dark";
          root.dataset.theme = next;
          try {
            localStorage.setItem("theme", next);
          } catch {}
          sync();
        });

        // someone flipping their OS theme with no explicit choice stored
        media.addEventListener("change", sync);
        sync();
      })();
    </script>
  </body>
</html>
