---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import { fullNumber, longDate } from "../lib/format.ts";
import { OG_DEFAULT_PATH } from "../lib/og.ts";
import { lastCrawledAt, listSummaries, overallPulse } from "../lib/queries.ts";
import { absolute } from "../lib/urls.ts";

export type Props = {
  title: string;
  description: string;
  /** defaults to the current route; pass one only to override a canonical */
  canonicalPath?: string;
  noindex?: boolean;
  /** JSON-LD objects, serialised into ld+json script tags */
  jsonLd?: unknown[];
  /** site-root path of a build-time card, e.g. ogListPath(slug); see src/lib/og.ts */
  ogImage?: string;
};

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  jsonLd = [],
} = Astro.props;

// both go through absolute() so the canonical and the sitemap can only ever
// derive from one place; Astro.site is additionally illegal inside
// getStaticPaths, so the helper is the form that works everywhere
const canonical = absolute(canonicalPath);
const ogImage = absolute(Astro.props.ogImage ?? OG_DEFAULT_PATH);

/**
 * What the site is, in three numbers, at the bottom of every page.
 *
 * The counts used to live in the placeholders of the search box and the list
 * filter, where they sat in front of a reader who was about to type over them
 * and said the same thing on all 3,977 pages. They belong with the crawl date:
 * all three are facts about the dataset rather than labels on a control, and
 * this is the line that already carries one of them. Every query behind them is
 * memoised and shared with the pages that already ask, so the footer costs the
 * build nothing.
 */
const [crawledAt, total, summaries] = await Promise.all([
  lastCrawledAt(),
  overallPulse().then((pulse) => pulse.total),
  listSummaries(),
]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Awesome Index" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#12151c"
      media="(prefers-color-scheme: dark)"
    />

    {
      /*
      Runs before the first paint so an explicit choice never flashes the other
      theme. It is deliberately tiny and inline: pulling it into a module would
      cost a round trip, and the round trip is the flash. Absence of the key
      means "follow the system", which the stylesheet already handles.
    */
    }
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark")
          document.documentElement.dataset.theme = t;
      } catch {}
    </script>

    {
      jsonLd.map((item) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(item)}
          is:inline
        />
      ))
    }
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-paper focus:px-3 focus:py-2"
    >
      Skip to content
    </a>

    <SiteHeader />

    <main id="main" class="mx-auto max-w-6xl px-5 py-8 sm:px-8">
      <slot />
    </main>

    {
      /*
      Two lines stacked on a phone, one line with the dataset pushed right from
      `sm` up. `ml-auto` inside a wrapping row was doing neither: once the two
      spans no longer fitted side by side, the second wrapped onto its own line
      and `auto` still shoved it against the right edge, leaving the footer
      ragged on exactly the widths where it wraps.
    */
    }
    <footer class="mt-16 border-t border-rule">
      <div
        class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-8 text-sm text-mute sm:flex-row sm:flex-wrap sm:items-baseline sm:gap-x-6 sm:px-8"
      >
        <span>
          Made with ♥ by{" "}
          <a
            class="text-accent hover:underline"
            href="https://donald.me"
            rel="noopener">Donald</a
          >{" "}and{" Claude Code"}
        </span>
        <span class="sm:ml-auto">
          {fullNumber(total)} projects in {summaries.length} lists{
            crawledAt && (
              <Fragment>
                , updated{" "}
                <time datetime={crawledAt.toISOString()}>
                  {longDate(crawledAt)}
                </time>
              </Fragment>
            )
          }
        </span>
      </div>
    </footer>
  </body>
</html>
