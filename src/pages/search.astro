---
import SearchApp, { type FeaturedRepo } from "../components/SearchApp.tsx";
import Base from "../layouts/Base.astro";
import { compactNumber, liveness } from "../lib/format.ts";
import { listSummaries, overallPulse, topRepos } from "../lib/queries.ts";
import { pushedSortValue, SEARCH_PATH } from "../lib/search.ts";
import { listPath } from "../lib/urls.ts";

/**
 * The one page on the site that runs JavaScript.
 *
 * `noindex, follow` on purpose: a search page holds no content of its own, it
 * is a view onto an index whose results live on github.com, and letting a
 * crawler in would put thousands of near-identical parameterised URLs into the
 * index. `follow` still lets the links out of the noscript fallback be crawled.
 *
 * The island is `client:only` because there is nothing here to pre-render: the
 * markup is a function of the Pagefind index, which does not exist until after
 * `astro build` has finished. Readers without JavaScript get the noscript
 * below, which is a real answer rather than an apology: the whole dataset is
 * browsable through the lists.
 *
 * What the island does *not* have to ask the index for is the state it opens
 * in. The most starred projects are a query this build can answer, and they go
 * up as props, so arriving on this page costs no index, no worker and no wasm
 * until the reader searches.
 */
const summaries = await listSummaries();

/**
 * Distinct projects, not list entries.
 *
 * The header counts entries (32.6K), which is the right number for "how much
 * have these lists curated". This page is a view onto the index, and the index
 * holds one record per project, so it counts projects (30.5K) — otherwise the
 * heading promises 2,132 rows that no search can ever return.
 */
const total = (await overallPulse()).total;

const lists = summaries.map((summary) => ({
  slug: summary.entry.slug,
  name: summary.entry.name,
  icon: summary.entry.icon,
}));

/** two "Show more" presses' worth; past that the reader is browsing, not searching */
const featured: FeaturedRepo[] = (await topRepos(50)).map((repo) => ({
  id: repo.id,
  blurb: repo.description.trim(),
  stars: repo.stars,
  pushed: pushedSortValue(repo.pushedAt),
  pulse: liveness(repo.pushedAt),
  language: repo.primaryLanguage ?? "",
  license: repo.license ?? "",
  archived: repo.archived,
  lists: repo.lists.join(" · "),
}));

const title = `Search ${compactNumber(total)} projects · Awesome Index`;
const description = `Search every project on Awesome Index by name and description, filtered by list, language, licence, GitHub topic and how recently anyone touched it.`;
---

<Base
  title={title}
  description={description}
  canonicalPath={SEARCH_PATH}
  noindex
>
  {
    /* the only heading the page needs: the query box states what this is, and
      a title plus a paragraph restating the filters was a screenful of chrome
      above the one control anybody came here to use */
  }
  <h1 class="sr-only">Search {compactNumber(total)} projects</h1>

  <noscript>
    <div class="mb-8 max-w-2xl border-l-2 border-rule pl-4">
      <p class="text-ink-soft">
        Search needs JavaScript. The index is a set of static files that the
        browser fetches and queries as you type, so with scripting turned off
        there is nothing to run the query: no query box, no filters, no sorting.
      </p>
      <p class="mt-3 text-ink-soft">
        Everything it would find is browsable instead: every list below is
        ordered by stars and split into the categories its curators wrote, with
        every project's note, pulse and link to GitHub on the row itself.
      </p>
      <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
        {
          summaries.map((summary) => (
            <li>
              <a
                class="text-accent underline-offset-4 hover:underline"
                href={listPath(summary.entry.slug)}
              >
                {summary.entry.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </noscript>

  <SearchApp
    client:only="preact"
    lists={lists}
    featured={featured}
    total={total}
  />
</Base>
