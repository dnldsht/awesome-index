---
import ListPage from "../../../components/ListPage.astro";
import { pulseBreakdown } from "../../../lib/format.ts";
import { pageCount, pageSlice } from "../../../lib/pagination.ts";
import {
  categoriesForList,
  listSummaries,
  reposForList,
} from "../../../lib/queries.ts";

/**
 * Page 2 and beyond of a list: `/golang/page/2/` to `/golang/page/43/`.
 *
 * This route exists rather than being folded into `[...category]` because the
 * `page` segment is static, and Astro ranks a static segment above a rest
 * param, so `/golang/page/2/` can only ever be matched here, never as a
 * category called "page/2". `categoriesForList()` additionally refuses to build
 * if a real heading ever slugifies into that shape, so the two route families
 * cannot both claim a path even by accident.
 *
 * Page 1 is deliberately absent: it belongs to `index.astro` at `/golang/`, and
 * emitting it here as well would be a second URL for the same rows.
 */
export async function getStaticPaths() {
  const summaries = await listSummaries();
  const paths = [];

  for (const summary of summaries) {
    const [repos, categories] = await Promise.all([
      reposForList(summary.entry),
      categoriesForList(summary.entry),
    ]);
    const totalPages = pageCount(repos.length);
    // the list's pulse split, not this page's: it is the same header on every
    // page of the list, and computing it per slice would make it wobble
    const breakdown = pulseBreakdown(repos);

    for (let page = 2; page <= totalPages; page++) {
      paths.push({
        // every param a string, including the page number
        params: { list: summary.entry.slug, page: String(page) },
        props: {
          summary,
          categories,
          repos: pageSlice(repos, page),
          breakdown,
          page,
          totalPages,
        },
      });
    }
  }

  return paths;
}
---

<ListPage {...Astro.props} />
