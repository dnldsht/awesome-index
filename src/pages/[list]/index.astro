---
import ListPage from "../../components/ListPage.astro";
import { pulseBreakdown } from "../../lib/format.ts";
import { pageCount, pageSlice } from "../../lib/pagination.ts";
import {
  categoriesForList,
  listSummaries,
  reposForList,
} from "../../lib/queries.ts";

/**
 * Page 1 of every *crawled* list. `listSummaries()` is the gate: a config entry
 * with no rows yet would otherwise get an empty page in the sitemap.
 *
 * Page 2 and beyond live in `page/[page].astro`, so this URL, the one that is
 * already indexed and linked from everywhere, does not move. Both routes
 * render `ListPage` and both cut the list with the same `pageSlice`, so the
 * only thing that differs between them is which slice they ask for.
 *
 * The queries run here rather than in the component body so the page stays a
 * pure render of its props.
 */
export async function getStaticPaths() {
  const summaries = await listSummaries();

  return await Promise.all(
    summaries.map(async (summary) => {
      const [repos, categories] = await Promise.all([
        reposForList(summary.entry),
        categoriesForList(summary.entry),
      ]);
      return {
        // Astro rejects non-string params, and every slug is already a string
        params: { list: summary.entry.slug },
        props: {
          summary,
          categories,
          repos: pageSlice(repos, 1),
          // computed from the whole list, which only this scope still holds
          breakdown: pulseBreakdown(repos),
          page: 1,
          totalPages: pageCount(repos.length),
        },
      };
    }),
  );
}
---

<ListPage {...Astro.props} />
