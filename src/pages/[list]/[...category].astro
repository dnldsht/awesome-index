---
import CategoryNav from "../../components/CategoryNav.astro";
import Pagination from "../../components/Pagination.astro";
import PulseBar from "../../components/PulseBar.astro";
import RepoCard from "../../components/RepoCard.astro";
import Base from "../../layouts/Base.astro";
import {
  fullNumber,
  pulseBreakdown,
  type PulseBreakdown,
} from "../../lib/format.ts";
import { firstOnPage, pageCount, pageSlice } from "../../lib/pagination.ts";
import {
  categoriesForList,
  listSummaries,
  reposForCategory,
  UNCATEGORIZED_SLUG,
  type Category,
  type ListSummary,
  type RepoWithSections,
} from "../../lib/queries.ts";
import { listSearchUrl } from "../../lib/search.ts";
import {
  absolute,
  categoryPagePath,
  listPath,
  PAGE_SEGMENT,
  repoPath,
} from "../../lib/urls.ts";

/**
 * One page per heading of every crawled list, plus the pages that heading
 * spills onto. The `category` param is a rest param because a section slug is a
 * heading *path* — "web-frameworks/middlewares/actual-middlewares" — and the
 * URL keeps that nesting so the hierarchy the list author wrote survives into
 * the site's shape.
 *
 * Pagination rides on the same rest param: page 2 of "utilities" is the param
 * "utilities/page/2", rendered at /golang/utilities/page/2/. That is the one
 * scheme this route could collide with itself, so `categoriesForList()` refuses
 * to build if a real heading ever slugifies into `…/page/<n>`.
 *
 * Headings are not the only thing on the route. Entries a list files above
 * every heading get the synthetic `UNCATEGORIZED_SLUG` category, which is how
 * 1,123 rows that used to be reachable only from the list page — 1,094 of them
 * from uhub/awesome-javascript, which writes no headings at all — get a page of
 * their own, and survive the list page no longer showing everything at once.
 */
export async function getStaticPaths() {
  const summaries = await listSummaries();
  const paths = [];

  for (const summary of summaries) {
    const categories = await categoriesForList(summary.entry);

    for (const category of categories) {
      const all = await reposForCategory(summary.entry, category.sectionSlug);
      // categoriesForList already counts only crawled repos, so this cannot
      // normally fire; it is here so a mid-crawl database can never emit a page
      // with nothing on it
      if (all.length === 0) continue;

      // The sitemap paginates from `category.count` and this route from the
      // rows it actually got. They are the same count(distinct repo_id) over
      // the same join, and the day they stop being so the symptom is a sitemap
      // advertising a page nobody wrote — so it fails here, loudly, rather than
      // there, silently.
      if (all.length !== category.count) {
        throw new Error(
          `${summary.entry.slug}/${category.slug}: categoriesForList counted ` +
            `${category.count} repos but reposForCategory returned ${all.length}`,
        );
      }

      const totalPages = pageCount(all.length);
      // the category's split, shared by every page of it
      const breakdown = pulseBreakdown(all);

      for (let page = 1; page <= totalPages; page++) {
        paths.push({
          // every param a string: the slug, the "/"-joined heading path, and
          // the page suffix on page 2 and beyond
          params: {
            list: summary.entry.slug,
            category:
              page === 1
                ? category.slug
                : `${category.slug}/${PAGE_SEGMENT}/${page}`,
          },
          props: {
            summary,
            category,
            categories,
            repos: pageSlice(all, page),
            breakdown,
            page,
            totalPages,
            totalRepos: all.length,
          },
        });
      }
    }
  }

  return paths;
}

type Props = {
  summary: ListSummary;
  category: Category;
  categories: Category[];
  /** this page's slice, not the whole category */
  repos: RepoWithSections[];
  /** across the whole category, not this page */
  breakdown: PulseBreakdown;
  /** 1-based */
  page: number;
  totalPages: number;
  totalRepos: number;
};

const {
  summary,
  category,
  categories,
  repos,
  breakdown,
  page,
  totalPages,
  totalRepos,
} = Astro.props;
const { entry } = summary;

const name = category.path.at(-1) ?? category.slug;
/** the synthetic heading, which needs different prose from a real one */
const bucket = category.slug === UNCATEGORIZED_SLUG;

const from = firstOnPage(page);
const to = from + repos.length - 1;
const range = `${fullNumber(from)}–${fullNumber(to)}`;

/**
 * A heading can nest under a parent that holds no links of its own, and such a
 * parent has no page. Ancestors are therefore only linked — and only enter the
 * breadcrumb JSON-LD — when a page for them actually exists.
 */
const emitted = new Set(categories.map((c) => c.slug));
const segments = category.slug.split("/");
const ancestors = segments.slice(0, -1).map((_, index) => {
  const slug = segments.slice(0, index + 1).join("/");
  return {
    slug,
    name: category.path[index] ?? slug,
    exists: emitted.has(slug),
  };
});

/**
 * Distinct per page in both the title and the description, because a page 2
 * repeating page 1's is a duplicate-content signal. The canonical is left to
 * `Base`, which writes the page's own URL: pointing page 2 back at page 1 would
 * ask Google to drop exactly the rows pagination exists to expose.
 */
const title =
  page === 1
    ? `${name} · Awesome ${entry.name} — ${fullNumber(totalRepos)} projects`
    : `${name} · Awesome ${entry.name} — projects ${range}, page ${page} of ${totalPages}`;

const where = bucket
  ? `listed before any heading on the awesome-${entry.slug} list`
  : `${name} projects from the awesome-${entry.slug} list`;

const description =
  page === 1
    ? `${fullNumber(totalRepos)} ${bucket ? `projects ${where}` : where}, most starred first, each showing how long it has been since anyone touched it.`
    : `Projects ${range} of ${fullNumber(totalRepos)} ${where}, most starred first, each showing how long it has been since anyone touched it.`;

const path = categoryPagePath(entry.slug, category.slug, page);

const crumbs = [
  { name: "Awesome Index", path: "/" },
  { name: entry.name, path: listPath(entry.slug) },
  ...ancestors
    .filter((ancestor) => ancestor.exists)
    .map((ancestor) => ({
      name: ancestor.name,
      path: categoryPagePath(entry.slug, ancestor.slug, 1),
    })),
  { name, path: categoryPagePath(entry.slug, category.slug, 1) },
  ...(page > 1 ? [{ name: `Page ${page}`, path }] : []),
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.name,
      item: absolute(crumb.path),
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name:
      page === 1
        ? `${entry.name} · ${name}`
        : `${entry.name} · ${name} — page ${page}`,
    description,
    url: absolute(path),
    // the whole category on every page; the window below is what changes, and
    // its positions stay absolute across pages
    numberOfItems: totalRepos,
    itemListOrder: "https://schema.org/ItemListOrderDescending",
    itemListElement: repos.slice(0, 25).map((repo, index) => ({
      "@type": "ListItem",
      position: from + index,
      name: repo.id,
      url: absolute(repoPath(repo.id)),
    })),
  },
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <nav aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-baseline gap-x-2 text-sm text-mute">
      <li>
        <a class="hover:text-accent hover:underline" href="/">Awesome Index</a>
      </li>
      <li aria-hidden="true">›</li>
      <li>
        <a
          class="hover:text-accent hover:underline"
          href={listPath(entry.slug)}
        >
          {entry.name}
        </a>
      </li>
      {
        ancestors.map((ancestor) => (
          <Fragment>
            <li aria-hidden="true">›</li>
            <li>
              {ancestor.exists ? (
                <a
                  class="hover:text-accent hover:underline"
                  href={categoryPagePath(entry.slug, ancestor.slug, 1)}
                >
                  {ancestor.name}
                </a>
              ) : (
                <span>{ancestor.name}</span>
              )}
            </li>
          </Fragment>
        ))
      }
      <li aria-hidden="true">›</li>
      {
        page === 1 ? (
          <li aria-current="page" class="text-ink-soft">
            {name}
          </li>
        ) : (
          <Fragment>
            <li>
              <a
                class="hover:text-accent hover:underline"
                href={categoryPagePath(entry.slug, category.slug, 1)}
              >
                {name}
              </a>
            </li>
            <li aria-hidden="true">›</li>
            <li aria-current="page" class="text-ink-soft">
              Page {page}
            </li>
          </Fragment>
        )
      }
    </ol>
  </nav>

  {
    /* Same treatment as the list header, and for the same reason: the sentence
      that used to live here restated the breadcrumb directly above it. What a
      reader cannot get from the breadcrumb is how big this heading is and how
      much of it still moves. */
  }
  <header class="mt-4">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
      <h1
        class="font-display text-3xl leading-[1.15] font-semibold tracking-tight sm:text-4xl"
      >
        {entry.name}{" "}
        <span class="text-mute" aria-hidden="true">·</span>{" "}
        {name}
      </h1>

      <a
        class="shrink-0 text-sm text-accent decoration-accent underline-offset-4 hover:underline"
        href={listSearchUrl(entry.slug)}
      >
        Search all {entry.name} projects →
      </a>
    </div>

    <p
      class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-soft"
    >
      <span class="font-medium tabular-nums">
        {fullNumber(totalRepos)}{" "}{totalRepos === 1 ? "project" : "projects"}
      </span>
      <span aria-hidden="true" class="text-mute">·</span>
      {
        bucket ? (
          <span class="text-mute">listed before any heading on the list</span>
        ) : (
          <span class="text-mute">{category.path.join(" › ")}</span>
        )
      }
      {
        totalPages > 1 && (
          <>
            <span aria-hidden="true" class="text-mute">
              ·
            </span>
            <span class="text-mute">
              showing {range}, page {page} of {totalPages}
            </span>
          </>
        )
      }
    </p>

    <div class="mt-4">
      <PulseBar breakdown={breakdown} />
    </div>
  </header>

  <div class="mt-10 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-12">
    <aside
      class="max-h-80 overflow-y-auto border-b border-rule pb-4 lg:sticky lg:top-8 lg:max-h-[calc(100vh-5rem)] lg:self-start lg:border-b-0 lg:pb-0"
    >
      <CategoryNav
        listSlug={entry.slug}
        categories={categories}
        currentSlug={category.slug}
        title={`More in ${entry.name}`}
      />
    </aside>

    <section class="mt-10 lg:mt-0">
      <h2 class="font-mono text-xs tracking-widest text-mute uppercase">
        {
          totalPages > 1
            ? `${name} — ${range} of ${fullNumber(totalRepos)}`
            : name
        }
      </h2>

      <ul class="mt-4 -mx-4 border-t border-rule">
        {
          repos.map((repo) => (
            <li class="border-b border-rule">
              <RepoCard repo={repo} note={repo.note} headingLevel={3} />
            </li>
          ))
        }
      </ul>

      <Pagination
        page={page}
        totalPages={totalPages}
        href={(n) => categoryPagePath(entry.slug, category.slug, n)}
        label={`${name} pages`}
      />
    </section>
  </div>

  <p class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm">
    <a class="text-accent hover:underline" href={listPath(entry.slug)}>
      Back to Awesome {entry.name}
    </a>
    {
      /* a plain link, not a widget: this page ships no JavaScript, and the
        search page reads its own filters out of the query string */
    }
    <a class="text-accent hover:underline" href={listSearchUrl(entry.slug)}>
      Search Awesome {entry.name} →
    </a>
  </p>
</Base>
