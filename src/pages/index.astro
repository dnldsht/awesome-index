---
import Base from "../layouts/Base.astro";
import {
  compactNumber,
  fullNumber,
  LIVENESS_ORDER,
  pulseBreakdown,
} from "../lib/format.ts";
import { luckyFallback } from "../lib/lucky.ts";
import { listPulses, listSummaries, overallPulse } from "../lib/queries.ts";
import { SEARCH_PATH } from "../lib/search.ts";
import { absolute, listPath } from "../lib/urls.ts";

const summaries = await listSummaries();

const pulse = await overallPulse();

/**
 * Distinct projects, not the sum of the lists' own counts: the two differ by
 * every repository more than one curator picked, some two thousand of them, and
 * this page now states the number twice — here and in the footer — where two
 * readings of "projects" a screen apart read as an error rather than as a
 * definition. This is also the one the search box can deliver.
 */
const total = pulse.total;

/**
 * The share that has gone three years without a commit, which is the claim the
 * whole site rests on and the only number here a README could not tell you.
 * Read from the data rather than written into the copy: it is a nightly crawl,
 * and a hardcoded "a third" would quietly drift away from the rows below it.
 */
const dormant = pulse.percentages.dormant;

const lucky = await luckyFallback();

/**
 * Every row used to end in "newest change just now", which is what a list of
 * any size always says: 80 rows of identical text carrying nothing. The share
 * that is still moving differs per list, which is the whole reason to look at
 * this page rather than at GitHub's topic search.
 */
const pulses = await listPulses();
const emptyPulse = pulseBreakdown([]);

/**
 * One row per list, with everything the row renders *and* everything the
 * filter-and-sort script sorts by resolved up front. The pulse lookup used to
 * happen inside the markup, which meant the numbers the script needs as
 * attributes were not available where the attributes are written.
 *
 * Ordered by the share still moving, not by size. Size is the ordering every
 * other index of awesome lists already has, and it puts the same four
 * enormous, half-abandoned lists on top of all of them; this is the one number
 * that needed a crawler to produce, so it is the one the page leads with. Ties
 * go to the bigger list, because 100% of nine projects is a smaller claim than
 * 100% of nine hundred. `listSummaries()` is memoised and shared, hence the
 * copy before sorting.
 */
const rows = [...summaries]
  .map((summary) => {
    const pulse = pulses.get(summary.entry.slug) ?? emptyPulse;
    return {
      summary,
      pulse,
      segments: LIVENESS_ORDER.filter((key) => pulse.counts[key] > 0),
    };
  })
  .sort(
    (a, b) =>
      b.pulse.percentages.active - a.pulse.percentages.active ||
      b.summary.repoCount - a.summary.repoCount,
  );

const title =
  "Awesome Index: GitHub's awesome lists, with the dead entries marked";
const description = `${compactNumber(total)} projects from ${summaries.length} curated awesome lists, sorted by stars and kept under the categories their curators wrote, each showing how long since anyone touched it.`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Awesome Index",
    url: absolute("/"),
    description,
  },
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <h1
    class="font-display text-4xl leading-[1.1] font-semibold tracking-tight sm:text-5xl"
  >
    The awesome lists,<br />
    <span class="text-mute">kept honest.</span>
  </h1>

  <p class="mt-6 max-w-xl text-lg text-ink-soft">
    {compactNumber(total)} projects from {summaries.length} lists, sorted by stars
    and kept under the categories their curators wrote. Every entry carries what a
    README leaves out: how long since anyone touched it, and {dormant}% have
    gone three years without a commit.
  </p>

  {
    /* This page used to open with a second copy of the header's search box,
      which is the one control already on all 3,977 pages. Two buttons instead,
      because the two ways in are "I know what I want" and "show me something":
      the first is the box that never left the header, the second had no door at
      all. */
  }
  <div class="mt-8 flex flex-wrap gap-3">
    <a
      id="lucky"
      href={lucky}
      data-pool="/lucky.json"
      class="cursor-pointer border border-rule px-4 py-2.5 text-sm font-medium text-ink hover:bg-sunk"
    >
      I'm feeling lucky
    </a>
    <a
      href={SEARCH_PATH}
      class="bg-accent px-4 py-2.5 text-sm font-medium text-paper hover:opacity-90"
    >
      Search {fullNumber(total)} projects →
    </a>
  </div>

  {
    /*
    Finding one of 80 lists is a different job from finding one of 32,000
    projects, and the button above does the second one: it leaves the page. This
    box never does: it filters the rows already on screen, which for a set this
    small is instant and needs no index. Both controls are revealed by the
    script that powers them, so a reader without JavaScript is not handed a
    filter that does nothing; the rows below are already in the order the
    default sort would put them in.
  */
  }
  <div class="mt-14 flex flex-wrap items-center gap-x-4 gap-y-3">
    <h2 class="font-mono text-xs tracking-widest text-mute uppercase">Lists</h2>

    <div id="list-controls" class="ml-auto hidden items-center gap-2">
      <label for="list-filter" class="sr-only">Filter lists</label>
      <input
        id="list-filter"
        type="search"
        placeholder="Filter lists"
        autocomplete="off"
        class="h-8 w-40 border border-rule bg-paper px-2.5 text-sm text-ink placeholder:text-mute hover:border-mute focus:border-accent focus:outline-none sm:w-48"
      />

      <label for="list-sort" class="sr-only">Sort lists</label>
      <select
        id="list-sort"
        class="h-8 cursor-pointer border border-rule bg-paper px-2 text-sm text-ink-soft hover:border-mute focus:border-accent focus:outline-none"
      >
        <option value="active">Most active</option>
        <option value="projects">Most projects</option>
        <option value="name">Name A–Z</option>
      </select>
    </div>
  </div>

  <ul id="list-index" class="mt-4 -mx-4 border-t border-rule">
    {
      rows.map(({ summary, pulse, segments }) => (
        <li
          class="border-b border-rule"
          data-search={`${summary.entry.name} ${summary.entry.slug}`.toLowerCase()}
          data-projects={summary.repoCount}
          data-active={pulse.percentages.active}
          data-name={summary.entry.name.toLowerCase()}
        >
          <a
            href={listPath(summary.entry.slug)}
            class="flex flex-wrap items-baseline gap-x-3 gap-y-1 px-4 py-4 hover:bg-sunk"
          >
            {summary.entry.icon && (
              <span aria-hidden="true">{summary.entry.icon}</span>
            )}
            <span class="font-display text-xl font-semibold tracking-tight">
              {summary.entry.name}
            </span>
            <span class="font-mono text-sm text-ink-soft tabular-nums">
              {compactNumber(summary.repoCount)} projects
            </span>
            <span class="ml-auto flex items-center gap-3">
              {/* a sparkline of the same scale the list page charts in full;
                  the number beside it is what carries the meaning */}
              <span
                class="hidden h-1.5 w-24 overflow-hidden rounded-full bg-sunk sm:flex"
                aria-hidden="true"
              >
                {segments.map((key) => (
                  <span
                    style={`width: ${(pulse.counts[key] / pulse.total) * 100}%; background: var(--pulse-${key})`}
                  />
                ))}
              </span>
              <span class="w-20 text-right text-sm text-mute tabular-nums">
                {pulse.percentages.active}% active
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <p id="list-empty" hidden class="mt-4 text-sm text-mute">
    No list matches that. <a
      class="text-accent underline decoration-accent/50 underline-offset-2 hover:decoration-accent"
      href={SEARCH_PATH}>Search the projects instead →</a
    >
  </p>
</Base>

{
  /*
  "I'm feeling lucky" is a real link before this runs and stays one after: the
  script only swaps which category it points at. It fetches the pool on the
  first hint of interest rather than on load, and rewrites `href` as soon as it
  lands, so a middle-click or a long-press opens a random page too instead of
  the one the build happened to pick. If the fetch is still in flight when the
  click comes, or never succeeded, the click follows the href already there.
*/
}
<script is:inline>
  (() => {
    const link = document.getElementById("lucky");
    if (!link) return;

    let pool = null;
    let pending = null;

    const pick = () => pool[Math.floor(Math.random() * pool.length)];

    const load = () => {
      if (pool || pending) return pending;
      pending = fetch(link.dataset.pool)
        .then((response) => (response.ok ? response.json() : null))
        .then((paths) => {
          if (Array.isArray(paths) && paths.length) {
            pool = paths;
            link.href = pick();
          }
        })
        .catch(() => {});
      return pending;
    };

    for (const event of ["pointerenter", "focus", "touchstart"]) {
      link.addEventListener(event, load, { passive: true, once: true });
    }

    link.addEventListener("click", (event) => {
      // let the browser have the modified clicks: the href is already random
      if (event.defaultPrevented || event.metaKey || event.ctrlKey) return;
      if (!pool) return;
      event.preventDefault();
      location.href = pick();
    });
  })();
</script>

<script is:inline>
  (() => {
    const controls = document.getElementById("list-controls");
    const list = document.getElementById("list-index");
    const filter = document.getElementById("list-filter");
    const sort = document.getElementById("list-sort");
    const empty = document.getElementById("list-empty");
    if (!controls || !list || !filter || !sort || !empty) return;

    const rows = [...list.children];
    const number = (row, key) => Number(row.dataset[key] || 0);
    const compare = {
      // the same tie-break the build sorted by, so re-picking the default
      // ordering puts the rows back in exactly the order they arrived in
      active: (a, b) =>
        number(b, "active") - number(a, "active") ||
        number(b, "projects") - number(a, "projects"),
      projects: (a, b) => number(b, "projects") - number(a, "projects"),
      name: (a, b) => a.dataset.name.localeCompare(b.dataset.name),
    };

    const apply = () => {
      const term = filter.value.trim().toLowerCase();
      const shown = new Set(
        rows.filter((row) => !term || row.dataset.search.includes(term)),
      );

      for (const row of rows) row.hidden = !shown.has(row);
      empty.hidden = shown.size > 0;

      // one reflow rather than 80: every row moves inside a fragment, and the
      // hidden ones ride along so they are still in the DOM for the next term
      const ordered = [...rows].sort(compare[sort.value] ?? compare.active);
      const fragment = document.createDocumentFragment();
      for (const row of ordered) fragment.append(row);
      list.append(fragment);
    };

    controls.classList.remove("hidden");
    controls.classList.add("flex");
    filter.addEventListener("input", apply);
    sort.addEventListener("change", apply);
  })();
</script>
