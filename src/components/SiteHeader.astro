---
import { compactNumber, fullNumber } from "../lib/format.ts";
import { listSummaries } from "../lib/queries.ts";
import { QUERY_PARAM, SEARCH_PATH } from "../lib/search.ts";
import { githubUrl, listPath, SOURCE_REPO } from "../lib/urls.ts";

/**
 * The site header, on every page.
 *
 * It used to hold a wordmark, a tagline nobody needed twice, and the theme
 * toggle. Now it carries the two things a reader actually wants from any page
 * of a 4,000 page site: a way to search it, and a way to get to another list,
 * plus the source repository, since a site whose whole claim is "these dates
 * are real" should say where the dates come from.
 *
 * Both stay free of JavaScript. The search box is a plain GET form pointed at
 * the search page, which already reads its whole state (query, filters, sort)
 * out of the query string, so submitting here lands on exactly the URL the
 * island would have produced. The list menu is a `<details>`: it does not close
 * on an outside click, which is the one behaviour a script would buy, and that
 * is not worth shipping a script to every page for.
 */
const summaries = await listSummaries();
const total = summaries.reduce((sum, summary) => sum + summary.repoCount, 0);

/** already sorted by size in listSummaries(), so this is the biggest few */
const featured = summaries.slice(0, 8);

/**
 * The three controls on the right are one row of equal boxes, so their size is
 * stated once here rather than three times in three slightly different ways,
 * which is how the theme toggle ended up a couple of pixels shorter than the
 * list menu. `h-8` and not padding alone: an icon-only button and a text button
 * only agree on height if the height is the thing that is set.
 */
const CONTROL =
  "flex h-8 shrink-0 cursor-pointer items-center border border-rule text-sm text-ink-soft hover:bg-sunk";
const ICON_CONTROL = `${CONTROL} w-8 justify-center`;
---

<header class="border-b border-rule">
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-4 gap-y-3 px-5 py-3 sm:px-8"
  >
    <a
      href="/"
      class="font-display text-lg font-semibold tracking-tight text-ink"
    >
      Awesome Index
    </a>

    <form
      role="search"
      method="get"
      action={SEARCH_PATH}
      class="order-last w-full sm:order-none sm:w-auto sm:min-w-56 sm:flex-1"
    >
      <label for="site-search" class="sr-only">Search projects</label>
      <input
        id="site-search"
        type="search"
        name={QUERY_PARAM}
        placeholder={`Search ${compactNumber(total)} projects`}
        autocomplete="off"
        class="w-full max-w-md border border-rule bg-paper px-3 py-1.5 text-sm text-ink placeholder:text-mute hover:border-mute focus:border-accent focus:outline-none"
      />
    </form>

    <nav
      class="ml-auto flex shrink-0 items-center gap-2"
      aria-label="Site navigation"
    >
      <details class="group relative">
        <summary
          class={`${CONTROL} list-none gap-1.5 px-2.5 [&::-webkit-details-marker]:hidden`}
        >
          Lists
          {
            /* a drawn chevron rather than the ▾ glyph, which every font renders
              at a different weight and none of them at the weight of the text
              beside it; it also gets to point the other way when the menu is
              open, which a character cannot do */
          }
          <svg
            aria-hidden="true"
            viewBox="0 0 12 12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-3 w-3 text-mute transition-transform group-open:rotate-180"
          >
            <path d="M2.75 4.5 6 7.75 9.25 4.5"></path>
          </svg>
        </summary>

        <div
          class="absolute right-0 z-20 mt-2 w-64 border border-rule bg-paper p-1.5 shadow-lg"
        >
          <ul>
            {
              featured.map((summary) => (
                <li>
                  <a
                    href={listPath(summary.entry.slug)}
                    class="flex items-baseline gap-2 px-2 py-1.5 text-sm hover:bg-sunk"
                  >
                    {summary.entry.icon && (
                      <span aria-hidden="true">{summary.entry.icon}</span>
                    )}
                    <span class="text-ink">{summary.entry.name}</span>
                    <span class="ml-auto font-mono text-xs text-mute tabular-nums">
                      {fullNumber(summary.repoCount)}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>

          <a
            href="/"
            class="mt-1 block border-t border-rule px-2 py-2 text-sm text-accent hover:bg-sunk"
          >
            All {summaries.length} lists →
          </a>
        </div>
      </details>

      {
        /* the source of the site itself, which is the one link a reader who
          wants to know how the dates were arrived at goes looking for */
      }
      <a
        href={githubUrl(SOURCE_REPO)}
        target="_blank"
        rel="noopener"
        class={ICON_CONTROL}
        title={`${SOURCE_REPO} on GitHub, opens in a new tab`}
      >
        <svg aria-hidden="true" viewBox="0 0 16 16" class="h-4 w-4">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a5.6 5.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        <span class="sr-only">Source on GitHub</span>
      </a>

      <button
        id="theme-toggle"
        type="button"
        class={ICON_CONTROL}
        aria-pressed="false"
      >
        <span aria-hidden="true">◑</span>
        <span class="sr-only">Switch to dark theme</span>
      </button>
    </nav>
  </div>
</header>

{
  /*
  The toggle is the only stateful control on a content page, so it gets a dozen
  lines of inline script rather than an island: hydrating a component to flip one
  attribute would ship a framework to every page on the site. The label always
  names the theme the click will switch *to*.
*/
}
<script is:inline>
  (() => {
    const button = document.getElementById("theme-toggle");
    if (!button) return;
    const root = document.documentElement;
    const media = matchMedia("(prefers-color-scheme: dark)");
    const label = button.querySelector(".sr-only");

    const isDark = () =>
      root.dataset.theme ? root.dataset.theme === "dark" : media.matches;

    const sync = () => {
      const dark = isDark();
      button.setAttribute("aria-pressed", String(dark));
      if (label)
        label.textContent = `Switch to ${dark ? "light" : "dark"} theme`;
    };

    button.addEventListener("click", () => {
      const next = isDark() ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
      sync();
    });

    // someone flipping their OS theme with no explicit choice stored
    media.addEventListener("change", sync);
    sync();
  })();
</script>
