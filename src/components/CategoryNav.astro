---
import { compactNumber } from "../lib/format.ts";
import type { Category } from "../lib/queries.ts";
import { categoryPath } from "../lib/urls.ts";

export type Props = {
  /** the config entry these categories belong to */
  listSlug: string;
  categories: Category[];
  /** the category being viewed, marked rather than removed */
  currentSlug?: string;
  /** the label above the nav, and its accessible name */
  title?: string;
};

const {
  listSlug,
  categories,
  currentSlug,
  title = "Categories",
} = Astro.props;

/**
 * Ordered by slug, not by size. A slug is the heading path joined with "/", so
 * lexical order puts every child immediately after its parent and the indent
 * below reads as the tree the README actually had. Sorting by count would
 * scatter "Web Frameworks › Middlewares" halfway down the page from
 * "Web Frameworks", and this nav is the only route to most of the site.
 */
const ordered = [...categories].sort((a, b) => a.slug.localeCompare(b.slug));

const headingId = `categories-${listSlug}`;

/** heading path depth, capped so a deep list cannot indent itself off-screen */
const depthOf = (slug: string) => Math.min(slug.split("/").length - 1, 3);
---

<nav aria-labelledby={headingId}>
  <h2
    id={headingId}
    class="font-mono text-xs tracking-widest text-mute uppercase"
  >
    {title}
  </h2>

  <p class="mt-1 text-xs text-mute">
    {compactNumber(categories.length)} sections
  </p>

  <ul class="mt-3 border-t border-rule text-sm">
    {
      ordered.map((category) => {
        const current = category.slug === currentSlug;
        return (
          <li class="border-b border-rule">
            <a
              href={categoryPath(listSlug, category.slug)}
              aria-current={current ? "page" : undefined}
              style={`padding-left:${depthOf(category.slug) * 0.75}rem`}
              class="flex items-baseline justify-between gap-3 py-1.5 pr-1 text-ink-soft hover:bg-sunk hover:text-ink aria-[current=page]:font-medium aria-[current=page]:text-accent"
            >
              <span class="min-w-0 break-words">
                {category.path.at(-1) ?? category.slug}
              </span>
              <span class="shrink-0 font-mono text-xs text-mute tabular-nums">
                {compactNumber(category.count)}
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
